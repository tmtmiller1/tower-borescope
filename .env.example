# Tower Borescope configuration.
#
# scripts/setup.sh copies this file to .env in the repository, and the application copies
# it to ~/Library/Application Support/Tower Borescope/.env on first launch. Variables that
# are already set in the process environment take precedence over both files.

# Local AI services.
TOWER_BORESCOPE_OLLAMA_URL=http://127.0.0.1:11434
TOWER_BORESCOPE_ANYTHINGLLM_URL=http://localhost:3001

# Native tools. Empty values use the copies packed into the application bundle, then the
# dynamic library path and PATH.
TOWER_BORESCOPE_LIBUSB_PATH=
TOWER_BORESCOPE_FFMPEG_PATH=

# Data locations. Empty values select ~/Library/Application Support/Tower Borescope for
# settings, ~/Pictures/Scope, ~/Movies/Scope and ~/Documents/Scope Reports.
TOWER_BORESCOPE_SETTINGS=
TOWER_BORESCOPE_PICTURES_DIR=
TOWER_BORESCOPE_MOVIES_DIR=
TOWER_BORESCOPE_REPORTS_DIR=

# API keys. The application stores keys entered in its AI settings in the macOS Keychain;
# these variables override the Keychain when set.
ANTHROPIC_API_KEY=
ANYTHINGLLM_API_KEY=
